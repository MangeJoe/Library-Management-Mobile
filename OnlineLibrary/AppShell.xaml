<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OnlineLibrary.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OnlineLibrary.Views"
    Title="OnlineLibrary"
     Shell.FlyoutBehavior="Disabled">


    <TabBar>
        <ShellContent
          Title="Register"
          ContentTemplate="{DataTemplate views:RegisterPage}"
          Route="RegisterPage"/>
        <ShellContent
          Title="Home"
          ContentTemplate="{DataTemplate views:IndexPage}"
          Route="IndexPage" />


    </TabBar>



</Shell>
