<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineLibrary.Views.BookPages.BookDetailsPage"
             xmlns:vModel="clr-namespace:OnlineLibrary.ViewModels.BookViewModels"
             x:DataType="vModel:BookDetailsViewModel"
             Title="BookDetailsPage">
    <VerticalStackLayout>
        
        <Label 
            Text="{Binding Title}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <HorizontalStackLayout Padding="10" Spacing="10">
            <Image Source="{Binding Image}"
                   WidthRequest="50"
                   HeightRequest="50" />
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Description}"
                       FontSize="14"
                       />
                <Label Text="{Binding Publisher}"
                       FontSize="10"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>