<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineLibrary.Views.BookPages.AddBookPage"
             xmlns:vmodels="clr-namespace:OnlineLibrary.ViewModels.BookViewModels"
             x:DataType="vmodels:AddBookViewModel"
             Title="AddBookPage">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Add Book"
               FontSize="28"
               HorizontalOptions="Center"
               FontAttributes="Bold"/>

            <Entry x:Name="txtTitle"
               Placeholder="book title"
               Text="{Binding Title}"
               />
            <Entry x:Name="txtDescription"
               Placeholder="book desciption"
               Text="{Binding Description}"/>

            <Entry x:Name="txtISBN"
                 Placeholder="book isbn"
                 Text="{Binding ISBN}"/>

            <Entry x:Name="txtGenre"
               Placeholder="book genre"
               Text="{Binding Genre}"/>

            <Entry x:Name="txtEdition"
               Placeholder="book edition"
               Text="{Binding Edition}"/>

            <Entry x:Name=" txtPublisher" 
               Placeholder="enter publisher of the book"
               Text="{Binding Publisher}"/>


            <Entry x:Name=" txtPubDate" 
               Placeholder="publication date"
               Text="{Binding Publication_Date}"/>

            <Entry x:Name=" txtStatus" 
               Placeholder="availability status"
               Text="{Binding Availability_Status}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">

                <Button x:Name="btnCreate"
                  Text="Add"
                  Command="{Binding AddBookCommand}" />

                <Button x:Name="btnCancel" 
                  Text="Cancel"
                  Grid.Column="1"
                  Command="{Binding CancelCommand}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>